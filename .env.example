# 多学科就医智助系统 · 环境变量模板
#
# 用法：
#   1. 复制本文件为 .env（放在 CHAIS/ 或 CHAIS/backend/ 下均可，应用会自动向上查找）
#   2. 填入真实值
#   3. ⚠️ .env 已被 .gitignore 忽略，**永远不要提交**；本模板文件 (.env.example) 可以提交
#
# 安全提醒：历史上曾有 API Key 明文写在代码里并进入 git 历史，
#          请到网关控制台**作废重建**该 Key，只把新 Key 填进 .env。

# ---------- LLM 网关（必填 AI_API_KEY）----------
AI_API_KEY=
AI_API_URL=https://openai.uniin.cn/openapi/v2/chat/completions
AI_MODEL_NAME=qwen-max-latest

# ---------- LLM 调用参数（可选）----------
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=60
AI_MAX_RETRIES=3

# ---------- Web 服务（可选）----------
# 默认只监听本机、关闭 debug；演示/提交请保持 APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false
# 全局 HTTP 请求体上限（字节）；当前最大病历长度为 8000 字，默认 1 MiB
APP_MAX_CONTENT_LENGTH=1048576
APP_AUTH_REQUIRED=true
APP_REVIEWER_MODE=simulation
# 生产/多人部署默认关闭逐病例自动授权；单审核员演示时可显式设为 true
APP_AUTO_ASSIGN_REVIEWER=false
APP_PATIENT_USERNAME=patient
APP_PATIENT_PASSWORD=replace-with-a-strong-patient-password
APP_DOCTOR_USERNAME=doctor
APP_DOCTOR_PASSWORD=replace-with-a-strong-doctor-password
APP_PATIENT_PASSWORD_HASH=
APP_DOCTOR_PASSWORD_HASH=
APP_PREVIEW_TTL_MINUTES=10
APP_PREVIEW_MAX_PER_USER=5
APP_PREVIEW_MAX_TOTAL=5000
APP_GUEST_TTL_MINUTES=30
APP_GUEST_SESSIONS_PER_HOUR=5
APP_GUEST_TRACKED_IPS=10000
APP_GUEST_PREVIEW_LIMIT=5
APP_GUEST_TRIAGE_LIMIT=2
APP_GUEST_MAX_CHARS=2000
# 登录失败限流与会话上限（按账号 + 来源地址）
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_FAILURE_WINDOW_SECONDS=300
APP_LOGIN_COOLDOWN_SECONDS=60
APP_MAX_SESSIONS_PER_ACCOUNT=5
APP_MAX_TOTAL_SESSIONS=10000
APP_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
