# 多学科就医智助系统 · 环境变量模板
#
# 用法：
#   1. 复制本文件为 .env（放在 CHAIS/ 或 CHAIS/backend/ 下均可，应用会自动向上查找）
#   2. 填入真实值
#   3. ⚠️ .env 已被 .gitignore 忽略，**永远不要提交**；本模板文件 (.env.example) 可以提交
#
# 安全提醒：历史上曾有 API Key 明文写在代码里并进入 git 历史，
#          请到网关控制台**作废重建**该 Key，只把新 Key 填进 .env。

# ---------- LLM 网关（必填 AI_API_KEY）----------
AI_API_KEY=
AI_API_URL=https://openai.uniin.cn/openapi/v2/chat/completions
AI_MODEL_NAME=qwen-max-latest

# ---------- LLM 调用参数（可选）----------
AI_CONNECT_TIMEOUT=10
AI_READ_TIMEOUT=60
AI_MAX_RETRIES=3

# ---------- Web 服务（可选）----------
# 默认只监听本机、关闭 debug；演示/提交请保持 APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=5000
APP_DEBUG=false
APP_AUTH_REQUIRED=true
APP_ALLOW_ROLE_LOGIN=false
APP_PATIENT_USERNAME=patient
APP_PATIENT_PASSWORD=replace-with-a-strong-patient-password
APP_DOCTOR_USERNAME=doctor
APP_DOCTOR_PASSWORD=replace-with-a-strong-doctor-password
APP_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
